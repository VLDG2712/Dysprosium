<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup=false no longer stops device-to-device transfer. The pairing key lives
     in flutter_secure_storage, wrapped by a Keystore key that never transfers, so a copied blob
     would be undecryptable anyway; and it's a private key. Exclude everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
