# /usr/lib/systemd/system/dysd.service
[Unit]
Description=Dysprosium daemon
Wants=network-online.target
After=network-online.target openrgb.service nzxt-ctl.service

[Service]
Type=exec
User=dysd
Group=dys
ExecStart=/usr/bin/dysd serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure

# /var/lib/dysd (CA, certs, allowlist) and /run/dysd (admin socket)
StateDirectory=dysd
StateDirectoryMode=0700
RuntimeDirectory=dysd
RuntimeDirectoryMode=0750
UMask=0007

# Hardening. dysd needs no privileges: cooling goes through nzxt-ctl's socket, RGB through
# OpenRGB on 127.0.0.1, root actions by starting fixed units that polkit allows only for this
# user (50-dysd.rules: dysd-gpu-limit@.service, dysd-reboot-windows.service, dysd-update.service).
# Child processes (nvidia-smi, checkupdates/fakeroot/pacman, yay, systemctl) inherit all of this.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# nvidia-smi (power readings) needs the NVIDIA control + GPU nodes; nothing else from /dev.
DevicePolicy=closed
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Blocked syscalls fail with EPERM instead of killing the process (children like pacman under
# fakeroot probe setuid & co. and cope with EPERM, as for any unprivileged user).
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
