# /usr/lib/systemd/system/dysd-update.service
# Started by dysd (polkit rule 50-dysd.rules) when the phone asks to apply updates (LAN only).
# Repo packages only (pacman -Syu / apt-get full-upgrade / dnf upgrade, picked by
# /usr/lib/dysd/apply-updates from /etc/os-release); AUR stays manual.
# Output: /var/log/dysd/update.log, result: /var/log/dysd/update.status (both read by dysd).
[Unit]
Description=Dysprosium: upgrade repository packages
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/dysd/apply-updates
ExecStopPost=/usr/lib/dysd/record-update-result
StandardOutput=truncate:/var/log/dysd/update.log
StandardError=inherit
# Never kill the package manager mid-transaction because of a slow mirror.
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
