# /usr/lib/sysusers.d/dysd.conf
# dysd runs as its own system user; members of group "dys" may use the local admin socket.
g dys -
u dysd - "Dysprosium daemon" /var/lib/dysd
m dysd dys
# nzxt-ctl's socket (/run/nzxt-ctl/daemon.sock) is root:nzxt-ctl 0660. Declared here too (a no-op
# if nzxt-ctl already created it) so the rpm provides group(nzxt-ctl) itself: dnf would otherwise
# refuse to install on PCs without nzxt-ctl.
g nzxt-ctl -
m dysd nzxt-ctl
