# /usr/lib/systemd/system/dysd-admin@.service
# One request from the phone's Processes / Services / System settings tabs, run as root.
# Started by dysd (polkit: 50-dysd.rules allows only start, only for user dysd). The instance is
# the request; /usr/lib/dysd/admin validates it and writes the result to /run/dysd-admin/<id>.
# Does nothing unless /etc/dysd/admin.conf exists.
[Unit]
Description=Dysprosium admin request %I
CollectMode=inactive-or-failed

[Service]
Type=oneshot
ExecStart=/usr/lib/dysd/admin %I
TimeoutStartSec=120
# Root, because that's the point; still no home directories, own /tmp, no setuid tricks.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
